{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FunkinTools",
  "version": "0.1.0",
  "identifier": "com.fg-guagua.funkin-tools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "src-tauri\\tools\\upx\\upx-5.2.0-win64\\upx.exe --best src-tauri\\target\\release\\funkin-tools.exe",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "Funkin Tools",
        "width": 800,
        "height": 600,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
